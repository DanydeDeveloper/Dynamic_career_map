generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id              String            @id @default(cuid())
  name            String
  age             Int
  grade           String
  city            String
  school          String?
  parentName      String?
  curatorName     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  profile         StudentProfile?
  parentRequest   ParentRequest?
  pastActivities  PastActivity[]
  eventMap        StudentEventMap[]
  feedback        EventFeedback[]
  visibility      CareerVisibility[]
  proposals       ChangeProposal[]
  strategy        CareerStrategy?
}

model StudentProfile {
  id                    String   @id @default(cuid())
  studentId             String   @unique
  interestsJson         String
  inclinationsJson      String
  activityFormatsJson   String
  stabilityJson         String
  summaryText           String
  curatorComment        String?
  updatedAt             DateTime @updatedAt
  student               Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ParentRequest {
  id                   String   @id @default(cuid())
  studentId            String   @unique
  expectations          String
  preferredAreasJson    String
  restrictedAreasJson   String
  budget                Int?
  availableTime         String?
  comment               String?
  createdAt             DateTime @default(now())
  student               Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model PastActivity {
  id                String  @id @default(cuid())
  studentId         String
  title             String
  activityType      String
  area              String
  period            String
  result            String?
  studentReaction   String?
  parentComment     String?
  curatorComment    String?
  student           Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Event {
  id                    String            @id @default(cuid())
  title                 String
  date                  DateTime
  time                  String
  format                String
  participationFormat   String
  eventType             String
  ageMin                Int
  ageMax                Int
  city                  String
  location              String?
  cost                  Int
  professionalAreasJson String
  activityFormatsJson   String
  goal                  String
  sourceUrl             String?
  status                String            @default("approved")
  createdAt             DateTime          @default(now())
  studentMaps           StudentEventMap[]
  feedback              EventFeedback[]
  proposals             ChangeProposal[]
}

model StudentEventMap {
  id               String   @id @default(cuid())
  studentId        String
  eventId          String
  priority         String
  status           String   @default("planned")
  goalForStudent   String
  curatorComment   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([studentId, eventId])
}

model EventFeedback {
  id                String   @id @default(cuid())
  studentId         String
  eventId           String
  interestScore     Int
  difficultyScore   Int
  engagementScore   Int
  fatigueScore      Int
  wantContinue      String
  liked             String?
  disliked          String?
  learned           String?
  wantTryNext       String?
  tagsJson          String
  createdAt         DateTime @default(now())
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model CareerVisibility {
  id              String   @id @default(cuid())
  studentId       String
  area            String
  score           Int
  level           String
  evidenceJson    String
  updatedAt       DateTime @updatedAt
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, area])
}

model ChangeProposal {
  id               String    @id @default(cuid())
  studentId        String
  triggerEventId   String?
  proposalType     String
  description      String
  oldValue         String?
  newValue         String?
  reason           String
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  approvedBy       String?
  approvedAt       DateTime?
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  triggerEvent     Event?    @relation(fields: [triggerEventId], references: [id], onDelete: SetNull)
}

model CareerStrategy {
  id                       String   @id @default(cuid())
  studentId                String   @unique
  strategySummary          String
  mainHypothesesJson       String
  areasToExpandJson        String
  areasToCheckJson         String
  recommendedFormatsJson   String
  risksJson                String
  next3MonthsFocus         String
  next12MonthsFocus        String
  updatedAt                DateTime @updatedAt
  student                  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
